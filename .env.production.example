KRYPTNET_DOMAIN=kryptscan.kryptnet.org
KRYPTNET_EMAIL=security@kryptnet.org

APP_NAME=Kryptnet Security Assessment
APP_ENV=production
APP_SECRET=replace-with-a-long-random-secret
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_COOKIE_NAME=kryptnet_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=24
TRUSTED_HOSTS=kryptscan.kryptnet.org
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
ALLOW_PRIVATE_NETWORK_TARGETS=false

DATABASE_PATH=data/vuln_app.db
REPORTS_DIR=data/reports

EMAIL_DELIVERY=smtp
EMAIL_FROM=security@kryptnet.org
SMTP_HOST=mail.kryptnet.org
SMTP_PORT=465
SMTP_USERNAME=support@kryptnet.org
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=false
SMTP_USE_SSL=true

KRYPTNET_PAYMENT_API_URL=https://payments.kryptnet.com/api
KRYPTNET_PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
PAYMENT_REQUIRED=false
PAYMENT_DEMO_MODE=false

SCANNER_BACKEND=worker
SCANNER_WORKER_URL=http://kryptnet-scanner:8000
SCANNER_WORKER_TOKEN=replace-with-shared-worker-token
SCANNER_WORKER_TIMEOUT_SECONDS=1800
SCANNER_MIN_FULL_SCAN_SECONDS=600
NUCLEI_PATH=nuclei
NMAP_PATH=nmap
SSLYZE_PATH=sslyze
TESTSSL_PATH=testssl.sh
ZAP_BASELINE_PATH=zap-baseline.py
NIKTO_PATH=nikto
AMASS_PATH=amass
SUBFINDER_PATH=subfinder
TRIVY_PATH=trivy
HTTPX_PATH=httpx
NAABU_PATH=naabu
DNSX_PATH=dnsx
KATANA_PATH=katana
WAFW00F_PATH=wafw00f
WHATWEB_PATH=whatweb
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
GRYPE_PATH=grype
CHECKOV_PATH=checkov
PROWLER_PATH=prowler
SCOUTSUITE_PATH=ScoutSuite

CLOUD_CHECKS_ENABLED=false
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
