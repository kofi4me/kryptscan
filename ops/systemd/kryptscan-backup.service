[Unit]
Description=Back up the KryptScan database
After=kryptnet-scan.service

[Service]
Type=oneshot
User=kryptnetlab
Group=kryptnetlab
WorkingDirectory=/opt/kryptnet-services/kryptscan-app
ExecStart=/opt/kryptnet-services/kryptscan-app/venv/bin/python -m ops.kryptscan_maintenance backup --destination /opt/kryptnet-services/kryptscan-app/backups --keep-days 14
UMask=0077
Nice=10
