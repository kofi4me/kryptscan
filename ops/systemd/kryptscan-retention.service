[Unit]
Description=Remove expired KryptScan report artifacts
After=kryptnet-scan.service

[Service]
Type=oneshot
User=kryptnetlab
Group=kryptnetlab
WorkingDirectory=/opt/kryptnet-services/kryptscan-app
ExecStart=/opt/kryptnet-services/kryptscan-app/venv/bin/python -m ops.kryptscan_maintenance cleanup --retention-days 30
UMask=0077
Nice=10
